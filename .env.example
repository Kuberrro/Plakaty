# Skopiuj do .env.local (ten plik NIE trafia do repozytorium) i uzupełnij.
# Oba parametry są publiczne z założenia: dane chroni logowanie i RLS.
# Gdzie je znaleźć: docs/WDROZENIE.md, krok 3.
VITE_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TWOJ_KLUCZ

# NIGDY nie wpisuj tu klucza secret (sb_secret_...) ani service_role.

# Opcjonalnie: adres podkładu mapowego (domyślnie OpenStreetMap).
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
